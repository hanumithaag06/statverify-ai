# ==========================================================
# StatVerify AI — .gitignore Configuration
# ==========================================================

# 1. Environment Variables & Secrets (CRITICAL: Do NOT commit secrets)
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# 2. Python Virtual Environments
.venv/
venv/
env/
ENV/

# 3. Python Bytecode & Cache Files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 4. Logs & Diagnostic Artifacts
logs/*.log
*.log

# 5. Generated Runtime Exports & Scratch Files
exports/*.pdf
scratch/

# 6. IDE & OS Metadata Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 7. Distribution / Build Artifacts
build/
dist/
*.egg-info/
